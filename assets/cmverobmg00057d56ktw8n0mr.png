<html><head><base href="https://acme-insights.example/"><meta charset="utf-8"><title>Acme Insights</title><style>*{box-sizing:border-box;margin:0;padding:0}body{font-family:-apple-system,Segoe UI,Helvetica,Arial,sans-serif;color:#1d2433;background:#fff}
header{display:flex;align-items:center;justify-content:space-between;padding:18px 48px;border-bottom:1px solid #eceef3}
.logo{font-weight:700;font-size:20px;color:#3b4cca;display:flex;gap:8px;align-items:center}.logo i{width:22px;height:22px;border-radius:6px;background:#3b4cca;display:inline-block}
nav{display:flex;gap:22px;font-size:14px}nav a{color:#4a5368;text-decoration:none}
.btn{display:inline-block;padding:12px 20px;border-radius:8px;font-size:15px;font-weight:600;text-decoration:none;border:0;cursor:pointer}
.b1{background:#3b4cca;color:#fff}.b2{background:#eef0fb;color:#3b4cca}.b3{background:#1d2433;color:#fff}.b4{background:#f4a62a;color:#1d2433}
.hero{padding:72px 48px 56px;display:grid;grid-template-columns:1.1fr 1fr;gap:48px;align-items:center;background:linear-gradient(180deg,#f7f8fd,#fff)}
.hero h1{font-size:44px;line-height:1.15;letter-spacing:-.5px}
.hero p{margin-top:18px;font-size:16px;line-height:1.6;color:#4a5368}
.ctas{margin-top:28px;display:flex;gap:10px;flex-wrap:wrap}
.mock{border-radius:12px;background:#fff;box-shadow:0 20px 60px rgba(30,40,90,.15);padding:18px;border:1px solid #e6e8f0}
.mock .bar{height:10px;border-radius:5px;background:#e6e8f0;margin:10px 0}.mock .chart{height:170px;border-radius:8px;background:linear-gradient(135deg,#dfe3fb,#f2f4fd);margin-top:14px}
.features{padding:64px 48px;display:grid;grid-template-columns:repeat(3,1fr);gap:28px}
.features h2{grid-column:1/-1;font-size:30px}
.card{border:1px solid #eceef3;border-radius:12px;padding:24px}.card h3{font-size:17px;margin-bottom:8px}.card p{font-size:14px;line-height:1.6;color:#4a5368}
.band{padding:56px 48px;background:#1d2433;color:#fff}.band h2{font-size:28px}.band p{margin-top:12px;color:#aab1c4;max-width:720px;line-height:1.6}
/* app */
.app{display:grid;grid-template-columns:240px 1fr;min-height:100vh;background:#f6f7fb}
aside{background:#fff;border-right:1px solid #eceef3;padding:20px 14px}aside a{display:block;padding:9px 12px;border-radius:7px;color:#4a5368;font-size:14px;text-decoration:none}aside a.on{background:#eef0fb;color:#3b4cca;font-weight:600}
main.app-main{padding:28px 36px}.top{display:flex;justify-content:space-between;align-items:center}.top h1{font-size:24px}
.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:22px}.kpi{background:#fff;border:1px solid #eceef3;border-radius:10px;padding:16px}.kpi small{color:#7a8296;font-size:12px}.kpi b{display:block;font-size:24px;margin-top:6px}
.panels{display:grid;grid-template-columns:2fr 1fr;gap:16px;margin-top:16px}.panel{background:#fff;border:1px solid #eceef3;border-radius:10px;padding:18px;min-height:230px}.panel h3{font-size:14px;color:#4a5368}
.empty{display:flex;flex-direction:column;align-items:center;justify-content:center;height:170px;color:#9aa1b2;font-size:14px}
form.signup{max-width:520px;margin:48px auto;background:#fff;border:1px solid #eceef3;border-radius:12px;padding:32px}
form.signup h1{font-size:26px;margin-bottom:6px}form.signup p{color:#4a5368;margin-bottom:20px;font-size:14px}
form.signup label{display:block;font-size:13px;margin:12px 0 6px;color:#4a5368}form.signup input,form.signup select{width:100%;padding:10px;border:1px solid #d9dce5;border-radius:7px;font-size:14px}
