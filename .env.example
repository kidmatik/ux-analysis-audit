# Database (SQLite for the MVP; swap provider in prisma/schema.prisma for Postgres)
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Google sign-in (optional; the Google button is disabled until both are set)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Encryption key for temporary credentials (32+ chars). Falls back to NEXTAUTH_SECRET.
CREDENTIALS_ENCRYPTION_KEY=""

# Claude analysis engine (optional; without a key the deterministic heuristic engine runs)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"

# Screen capture: path to a Chromium binary for Playwright (live URL + demo login capture)
CHROMIUM_PATH=""

# Figma: server-wide token, used when the user does not paste their own
FIGMA_TOKEN=""

# Where uploads and captures are stored
STORAGE_DIR="./data/uploads"

# Bottom-of-report CTAs (optional; without them the CTAs open a request form stored in the DB)
HUMAN_AUDIT_URL=""
STRATEGY_CALL_URL=""

# Billing (Pro, $39/month). Without Stripe keys, "Go Pro" activates Pro instantly in
# development so the full report can be tested; in production set ALLOW_DEMO_UPGRADE=true to allow that.
STRIPE_SECRET_KEY=""
STRIPE_PRICE_ID=""
STRIPE_WEBHOOK_SECRET=""
ALLOW_DEMO_UPGRADE=""
